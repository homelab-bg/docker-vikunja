# Copy to .env and fill in real values - .env is gitignored.
# This repo is public - see README for why only placeholder values appear
# below.

# The full URL Vikunja is reached at, scheme included - plain http://host:3456
# for the base (no-Traefik) deployment, or https://<your real hostname> once
# the Traefik overlay is applied (must then match VIKUNJA_HOST below).
VIKUNJA_PUBLICURL=https://vikunja.lan.example.internal

# Required - a random secret used to sign session tokens. Without one set,
# Vikunja generates a new random secret on every restart, silently logging
# everyone out each time (confirmed via Vikunja's own config docs).
# Generate with: openssl rand -hex 32
VIKUNJA_SERVICE_SECRET=changeme

# Optional - defaults shown.
#VIKUNJA_VER=2.8.0
#STACK_NAME=vikunja
#VIKUNJA_ENABLE_REGISTRATION=false

# Optional - set to a real dataset/directory path to use a bind mount
# instead of the named-volume default.
#VIKUNJA_DB_PATH=/mnt/pool/Apps/vikunja/db
#VIKUNJA_FILES_PATH=/mnt/pool/Apps/vikunja/files

# Traefik overlay only (docker-compose.traefik.yml). Must match the host in
# VIKUNJA_PUBLICURL above.
NETWORK=traefik
VIKUNJA_HOST=vikunja.lan.example.internal
